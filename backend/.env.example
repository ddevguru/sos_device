# Server Port
PORT=5000

# JWT Authentication
JWT_SECRET=super_secret_sos_emergency_jwt_key_2026

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sos_db
# Or full connection string:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/sos_db

# SMS Service Provider (options: 'mock', 'twilio', 'fast2sms')
# 'mock' logs SMS directly to console with clean formatting (perfect for dev & testing)
SMS_PROVIDER=mock

# Twilio SMS Configuration (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Fast2SMS Configuration (India) (if SMS_PROVIDER=fast2sms)
FAST2SMS_API_KEY=your_fast2sms_api_key

# IoT Hardware Authentication
# Devices send this token in header 'x-iot-key' or request body
IOT_SECRET_KEY=sos_iot_secure_device_secret_2026
